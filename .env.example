# ==============================================================================
# Trading Bot Configuration Template
# Copy this file to .env and fill in your private API keys and parameters
# ==============================================================================

# --- Trading 212 API Configuration (HTTP Basic Auth) ---
# Trading 212 uses Basic Auth: base64(API_KEY:API_SECRET)
T212_API_KEY=49065255ZmRFXguyGWjMDcYDppYLbItwgTvwS
T212_SECRET_KEY=oFad1uavH7tWzMJ494SdtBU8TEF8_BVHXljMQJJ7duo

# Environment options: "demo" (default) or "live"
T212_ENVIRONMENT=live
# Maximum allowed allocation per individual order in your account currency (e.g. 50.0)
T212_MAX_ORDER_VALUE=50.0

# --- Market Data Configuration (yfinance) ---
# yfinance does not require an API key and has no tight 25 req/day limit.
# Optional Alpha Vantage key for fallback if needed:
ALPHA_VANTAGE_API_KEY=IYR3NY1Q5CO8MI28

# --- Groq Cloud AI Integration (Ultra-fast LLM Analysis) ---
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=here
# Supported active Groq models:
# - llama-3.3-70b-versatile (Recommended default, ultra-fast & intelligent)
# - llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_AI_ANALYSIS=true

# --- Telegram Notifier Bot ---
# 1. Create a bot using @BotFather on Telegram to get your token.
# 2. Start a chat with @userinfobot or invite your bot to a group to get your chat ID.
TELEGRAM_BOT_TOKEN=8500213807:AAEManVaOMRr0FXp97alKrvMxNNlzFnrrZQ
TELEGRAM_CHAT_ID=892335554
ENABLE_TELEGRAM_ALERTS=true

# --- Crypto Exchange Configuration (Coinbase / CCXT) ---
# Coinbase CDP API Key & Secret Key for authenticated live wallet balances.
# If omitted, crypto market scanning runs smoothly in public simulation mode without wallet balance.
COINBASE_API_KEY=organizations/c7414911-04ac-443d-a55b-26582b7b11c2/apiKeys/db7c9515-d645-4615-bcd9-888970890944
COINBASE_SECRET_KEY=ug/vc9SDigiTguRs8ulNGmKxwSuxr0F41U3ESYyY62WZrgWsdh+sb233lFrK2OXL3kKK8aBM0iV8Wn932Nlimw==
CRYPTO_EXCHANGE_NAME=coinbase

# --- Obsidian Local REST API Configuration ---
# Generate in Obsidian -> Settings -> Community Plugins -> Local REST API -> Copy API Key
OBSIDIAN_REST_API_KEY=41e1a7edbc3ffc885221dc82a5bf797f7a226e6effb420a6d3f18006101c3cd1
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124
# Set to true if using HTTPS (Local REST API plugin defaults to HTTPS on 27124)
OBSIDIAN_USE_HTTPS=true
# Set to false to bypass self-signed certificate warnings from Obsidian Local REST API
OBSIDIAN_VERIFY_SSL=false
# Folder inside your Obsidian Vault where trade notes are written
OBSIDIAN_VAULT_FOLDER=Trading-Logs

# --- Strategy & Scheduler Settings ---
# Comma-separated list of stock ticker symbols (e.g. AAPL_US_EQ, MSFT_US_EQ, NVDA_US_EQ)
WATCHLIST_TICKERS=AAPL_US_EQ,MSFT_US_EQ,NVDA_US_EQ
# Default capital amount to spend per buy order (in account currency)
BUY_ALLOCATION_VALUE=25.0
# Percentage drop from Moving Average or recent high to trigger a buy (e.g. 2.0 for 2%)
DIP_THRESHOLD_PERCENT=2.0
# Short-term Simple Moving Average period (in days)
SMA_SHORT_PERIOD=10
# Long-term Simple Moving Average period (in days)
SMA_LONG_PERIOD=50
# Interval between automated market evaluation cycles in minutes
CHECK_INTERVAL_MINUTES=15
# Dry Run Mode: if true, evaluates strategy and logs to Obsidian without placing real broker orders
DRY_RUN=false
